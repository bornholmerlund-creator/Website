---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Section from "../../components/Section.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Button from "../../components/Button.astro";
import StatBand from "../../components/StatBand.astro";
import FAQ from "../../components/FAQ.astro";
import CTABand from "../../components/CTABand.astro";
import { serviceContent, serviceSlugs } from "../../data/services";
import { services as navServices } from "../../config/site";

export function getStaticPaths() {
  return serviceSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const s = serviceContent[slug as string];
if (!s) return Astro.redirect("/services/");

const related = navServices.filter((n) => n.slug !== slug).slice(0, 3);

const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: s.title,
  description: s.metaDescription,
  provider: { "@type": "Organization", name: "Northbound Data" },
  areaServed: ["GB", "EU", "US"],
};
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: s.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---
<BaseLayout
  title={s.metaTitle}
  description={s.metaDescription}
  canonical={`/services/${s.slug}/`}
  jsonLd={[serviceLd, faqLd]}
>
  <PageHero eyebrow={s.eyebrow} title={s.hero} lead={s.lead}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/contact/" variant="primary" class="group">Discuss your situation</Button>
      <Button href="/case-studies/" variant="onInk" class="group">See results</Button>
    </div>
  </PageHero>

  <!-- Problem -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <Eyebrow>The problem</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{s.problem.heading}</h2>
        <p class="prose-lead mt-5">{s.problem.body}</p>
      </div>
      <ul class="space-y-4 self-center">
        {s.problem.points.map((p) => (
          <li class="flex gap-3 rounded-xl border border-ink-100 bg-white p-4 text-sm leading-relaxed text-ink-700 shadow-card">
            <svg class="mt-0.5 h-5 w-5 flex-none text-signal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- Approach -->
  <Section tone="ink">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <div>
        <Eyebrow tone="dark">Our approach</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold text-white sm:text-4xl">{s.approach.heading}</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-300">{s.approach.intro}</p>
      </div>
      <ol class="list-none">
        {s.approach.steps.map((step, i) => (
          <li class="relative flex gap-5 pb-9 last:pb-0">
            {i < s.approach.steps.length - 1 && <span class="absolute left-[19px] top-12 h-[calc(100%-2.5rem)] w-px bg-ink-700" aria-hidden="true"></span>}
            <span class="z-10 flex h-10 w-10 flex-none items-center justify-center rounded-full bg-signal-600 font-mono text-sm font-semibold text-white">{i + 1}</span>
            <div class="pt-1">
              <h3 class="font-serif text-xl font-semibold text-white">{step.title}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <!-- Outcomes + Deliverables -->
  <Section tone="sand">
    <div class="mb-10 max-w-2xl">
      <Eyebrow>What you get</Eyebrow>
      <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Outcomes you can hold us to.</h2>
    </div>
    <StatBand stats={s.outcomes} />
    <div class="mt-12 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {s.deliverables.map((d) => (
        <div class="flex items-start gap-3 rounded-xl border border-ink-100 bg-white p-4 text-sm font-medium text-ink-800 shadow-card">
          <svg class="mt-0.5 h-5 w-5 flex-none text-signal-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 13 4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>{d}</span>
        </div>
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <Eyebrow>FAQ</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">{s.title}, in plain terms.</h2>
        <div class="mt-8">
          <h3 class="font-sans text-xs font-semibold uppercase tracking-widest text-ink-400">Related services</h3>
          <ul class="mt-3 space-y-2">
            {related.map((r) => (
              <li><a href={`/services/${r.slug}/`} class="text-sm font-medium text-signal-700 hover:text-signal-800">{r.title} →</a></li>
            ))}
          </ul>
        </div>
      </div>
      <FAQ items={s.faq} />
    </div>
  </Section>

  <CTABand />
</BaseLayout>
