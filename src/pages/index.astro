---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import ServiceCard from "../components/ServiceCard.astro";
import StatBand from "../components/StatBand.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import FAQ from "../components/FAQ.astro";
import CTABand from "../components/CTABand.astro";
import { services, site } from "../config/site";
import { getCollection } from "astro:content";

const featured = (await getCollection("caseStudies")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const faqItems = [
  { q: "Do you resell ERP software?", a: "No. We take no licence commissions or reseller fees from any vendor. That's what makes our advice on platform fit genuinely neutral — our only incentive is your project succeeding." },
  { q: "We've already started (or finished) an implementation. Can you still help?", a: "Yes. We're often brought in to rescue a programme that's slipping, or to optimise a system that went live underused. The earlier we're involved the better, but it's rarely too late to recover value." },
  { q: "How is Keelstone different from a system integrator?", a: "Integrators are paid to configure software. We're accountable for the business outcome — the data tying out, the processes improving, and the system actually getting adopted. We lead with the data, because that's what quietly decides whether the rest works." },
  { q: "What size of business do you work with?", a: "Mid-sized organisations — typically 50 to 1,000 staff — that need the rigour of enterprise delivery without enterprise bureaucracy or cost." },
  { q: "How do you price engagements?", a: "Fixed-scope phases with clear deliverables and exit criteria, not open-ended time-and-materials. You know what each phase costs and what 'done' looks like before it begins." },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={undefined}
  description={site.description}
  jsonLd={faqLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 30px 30px;"></div>
    <div class="absolute -right-48 -top-48 h-[32rem] w-[32rem] rounded-full bg-signal-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -left-32 bottom-0 h-80 w-80 rounded-full bg-ink-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative py-24 lg:py-32">
      <div class="max-w-3xl reveal">
        <Eyebrow tone="dark">Vendor-neutral ERP &amp; data consultancy</Eyebrow>
        <h1 class="mt-6 font-serif text-4xl font-semibold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
          We fix the data before<br class="hidden sm:block" /> we touch the system.
        </h1>
        <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-300 sm:text-xl">
          Most ERP projects don't fail on software — they fail on data nobody owned. Keelstone gives mid-sized businesses an implementation that launches on time, reconciles on day one, and earns trust from the floor to the boardroom.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <Button href="/contact/" variant="primary" class="group">Book a working session</Button>
          <Button href="/case-studies/" variant="onInk" class="group">See the outcomes</Button>
        </div>
        <p class="mt-8 text-sm text-ink-400">No reseller commissions · Fixed-scope phases · Senior people in the room</p>
      </div>
    </div>
  </section>

  <!-- Stat band: the case for data-first -->
  <Section tone="sand" pad="tight">
    <div class="mb-10 max-w-2xl">
      <Eyebrow>The numbers behind the risk</Eyebrow>
      <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">The software is rarely the problem.</h2>
      <p class="prose-lead mt-4">Industry research is consistent: the projects that fail share a root cause, and it isn't the platform.</p>
    </div>
    <StatBand
      stats={[
        { value: "~23%", label: "of ERP implementations are considered a clear success" },
        { value: "~49%", label: "of organisations struggle with data migration" },
        { value: "75%+", label: "of ERP failures trace back to data issues" },
        { value: "73%", label: "lower migration-failure rate with proper planning" },
      ]}
    />
    <p class="mt-5 text-xs text-ink-400">Sources: industry ERP failure and data-migration research, 2025. Figures are directional and used to frame risk, not as guarantees.</p>
  </Section>

  <!-- Services -->
  <Section>
    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <Eyebrow>What we do</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">From data foundation to system go-live — one accountable partner.</h2>
        <p class="prose-lead mt-4">Seven connected disciplines. We can run the whole programme or strengthen the part that's at risk.</p>
      </div>
      <Button href="/services/" variant="secondary" class="group shrink-0">All services</Button>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <ServiceCard
          index={i}
          title={s.title}
          short={s.short}
          blurb={s.blurb}
          href={`/services/${s.slug}/`}
        />
      ))}
    </div>
  </Section>

  <!-- Differentiators -->
  <Section tone="ink">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
      <div>
        <Eyebrow tone="dark">Why Keelstone</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold text-white sm:text-4xl">Built to be accountable, not just billable.</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-300">We took deliberate positions that most firms won't — because they're what actually protect your outcome.</p>
        <div class="mt-8"><Button href="/approach/" variant="primary" class="group">How we work</Button></div>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-2xl bg-ink-800 sm:grid-cols-2">
        {[
          { t: "Vendor-neutral", d: "Zero licence commissions. Our platform advice serves you, not a reseller quota." },
          { t: "Data-first", d: "We start where projects actually break — the data — not where the demo looks best." },
          { t: "Fixed-scope phases", d: "Defined deliverables and exit criteria. No open-ended meters running." },
          { t: "Senior by default", d: "The people who scope the work do the work. No bait-and-switch to juniors." },
        ].map((item) => (
          <div class="bg-ink-950 p-7">
            <dt class="font-serif text-xl font-semibold text-white">{item.t}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-ink-300">{item.d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <!-- Case studies -->
  <Section tone="sand">
    <div class="mb-12 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <Eyebrow>Proof</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Outcomes, measured.</h2>
        <p class="prose-lead mt-4">We report results in the units executives care about: time, accuracy and cash.</p>
      </div>
      <Button href="/case-studies/" variant="secondary" class="group shrink-0">All case studies</Button>
    </div>
    <div class="grid gap-5 md:grid-cols-3">
      {featured.map((cs) => (
        <CaseStudyCard
          href={`/case-studies/${cs.slug}/`}
          client={cs.data.client}
          industry={cs.data.industry}
          title={cs.data.title}
          metric={cs.data.metric}
          metricLabel={cs.data.metricLabel}
        />
      ))}
    </div>
  </Section>

  <!-- FAQ -->
  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div>
        <Eyebrow>Questions</Eyebrow>
        <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Straight answers.</h2>
        <p class="prose-lead mt-4">The things executives ask us before the first conversation.</p>
      </div>
      <FAQ items={faqItems} />
    </div>
  </Section>

  <CTABand />
</BaseLayout>
