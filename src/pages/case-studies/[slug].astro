---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import StatBand from "../../components/StatBand.astro";
import CTABand from "../../components/CTABand.astro";
import Button from "../../components/Button.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies");
  return studies.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const ld = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  about: d.industry,
  datePublished: d.publishDate.toISOString(),
  author: { "@type": "Organization", name: "Keelstone" },
  publisher: { "@type": "Organization", name: "Keelstone" },
};
---
<BaseLayout title={d.title} description={d.summary} canonical={`/case-studies/${entry.slug}/`} ogType="article" jsonLd={ld}>
  <section class="relative overflow-hidden border-b border-ink-100 bg-ink-950 text-white">
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="container-page relative py-20 lg:py-24">
      <a href="/case-studies/" class="text-sm font-medium text-signal-300 hover:text-signal-200">← All case studies</a>
      <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-400">
        <span>{d.industry}</span>
        <span aria-hidden="true">·</span>
        <span>{d.client}</span>
      </div>
      <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold leading-tight sm:text-5xl">{d.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300">{d.summary}</p>
      <div class="mt-7 flex flex-wrap gap-2">
        {d.services.map((svc) => (
          <span class="rounded-full border border-ink-700 px-3 py-1 text-xs font-medium text-ink-200">{svc}</span>
        ))}
      </div>
    </div>
  </section>

  <Section tone="sand" pad="tight">
    <StatBand stats={d.results} />
  </Section>

  <Section>
    <div class="mx-auto max-w-3xl">
      <article class="prose-article text-ink-700">
        <Content />
      </article>
      <div class="mt-12 border-t border-ink-100 pt-8">
        <Button href="/contact/" variant="primary" class="group">Discuss a similar challenge</Button>
      </div>
    </div>
  </Section>

  <CTABand />
</BaseLayout>

<style is:global>
  .prose-article h2 { font-family: var(--font-serif); font-size: var(--text-2xl); font-weight: 600; color: var(--color-ink-900); margin-top: 2.5rem; margin-bottom: 0.75rem; letter-spacing: -0.02em; }
  .prose-article p { font-size: var(--text-lg); line-height: 1.7; margin-bottom: 1.25rem; }
  .prose-article ul { margin: 1.25rem 0; padding-left: 1.25rem; list-style: disc; }
  .prose-article li { margin-bottom: 0.6rem; line-height: 1.65; }
  .prose-article strong { color: var(--color-ink-900); font-weight: 600; }
  .prose-article blockquote { border-left: 3px solid var(--color-signal-500); padding-left: 1.25rem; margin: 2rem 0; font-family: var(--font-serif); font-size: var(--text-xl); font-style: italic; color: var(--color-ink-800); }
</style>
