---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Section from "../components/Section.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CTABand from "../components/CTABand.astro";
import { site } from "../config/site";

const values = [
  { t: "Tell the truth early", d: "Including when the truth is 'don't do this project yet.' Hard advice given early is cheaper than easy advice given late." },
  { t: "Earn trust with evidence", d: "We reconcile, we measure, we document. Trust is built on numbers that tie out, not on confidence." },
  { t: "Leave you stronger", d: "Success is what survives our departure — owned data, capable teams, systems that hold." },
];
---
<BaseLayout
  title="About"
  description="Northbound Data is a vendor-neutral ERP and data consultancy for mid-sized business — senior practitioners who lead with data and stay accountable to outcomes."
  canonical="/about/"
>
  <PageHero
    eyebrow="About Northbound Data"
    title="We built the firm we wished our clients had called first."
    lead="Northbound Data exists because too many ERP programmes are sold by people who won't be there when the data doesn't reconcile. We're the senior practitioners who stay."
  />

  <Section>
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr] lg:gap-16">
      <div class="space-y-5 text-lg leading-relaxed text-ink-700">
        <p>Most of our work begins with a rescue or a second opinion. A programme has slipped, a go-live reconciled badly, or a board is about to spend seven figures replacing a system that a quarter of optimisation could have saved.</p>
        <p>The common thread is always the same: the data was treated as someone else's problem, and accountability for the outcome belonged to no one. We started Northbound Data to invert both — to lead with data, and to own the result.</p>
        <p>We're deliberately mid-market. Large enough to run a full programme, small enough that the senior people who scope your work are the ones who do it. We take no software commissions, so when we recommend a platform — or recommend keeping yours — you can trust why.</p>
      </div>
      <aside class="rounded-2xl border border-ink-100 bg-white p-7 shadow-card">
        <h2 class="font-serif text-xl font-semibold text-ink-900">At a glance</h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div><dt class="text-ink-400">Founded</dt><dd class="font-medium text-ink-900">{site.founded}</dd></div>
          <div><dt class="text-ink-400">Focus</dt><dd class="font-medium text-ink-900">Mid-sized businesses, 50–1,000 staff</dd></div>
          <div><dt class="text-ink-400">Stance</dt><dd class="font-medium text-ink-900">Vendor-neutral · data-first</dd></div>
          <div><dt class="text-ink-400">Locations</dt><dd class="font-medium text-ink-900">{site.location}</dd></div>
        </dl>
      </aside>
    </div>
  </Section>

  <Section tone="sand" pad="tight">
    <div class="mb-10 max-w-2xl">
      <Eyebrow>What we value</Eyebrow>
      <h2 class="mt-4 font-serif text-3xl font-semibold sm:text-4xl">Three things we won't trade away.</h2>
    </div>
    <dl class="grid gap-px overflow-hidden rounded-2xl bg-ink-100 md:grid-cols-3">
      {values.map((v) => (
        <div class="bg-white p-7">
          <dt class="font-serif text-xl font-semibold text-ink-900">{v.t}</dt>
          <dd class="mt-2 text-sm leading-relaxed text-ink-600">{v.d}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <CTABand />
</BaseLayout>
