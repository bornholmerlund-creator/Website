---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
---
<BaseLayout title="Page not found" description="The page you were looking for could not be found." noindex={true}>
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="absolute inset-0 opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="container-page relative flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
      <p class="font-mono text-sm font-semibold tracking-widest text-signal-300">ERROR 404</p>
      <h1 class="mt-4 font-serif text-5xl font-semibold">This record didn't reconcile.</h1>
      <p class="mt-5 max-w-md text-lg text-ink-300">The page you're after doesn't exist — or moved. Let's get you back to something that does.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href="/" variant="primary" class="group">Back to home</Button>
        <Button href="/services/" variant="onInk" class="group">Browse services</Button>
      </div>
    </div>
  </section>
</BaseLayout>
