---
import { site, mainNav } from "../config/site";
import Logo from "./Logo.astro";
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-ink-100/70 bg-sand-50/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-6 lg:h-18">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.name} home`}>
      <Logo class="h-7 w-7 text-signal-600" />
      <span class="font-serif text-xl font-semibold tracking-tight text-ink-900">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {mainNav.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
          class:list={[
            "rounded-lg px-3 py-2 text-sm font-medium transition-colors",
            isActive(item.href)
              ? "text-ink-900"
              : "text-ink-500 hover:text-ink-900 hover:bg-ink-50",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/contact/"
        class="hidden rounded-lg bg-ink-900 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-ink-800 sm:inline-flex"
      >
        Book a working session
      </a>
      <details class="relative lg:hidden">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-ink-200 text-ink-700 [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/></svg>
        </summary>
        <div class="absolute right-0 mt-2 w-60 rounded-xl border border-ink-100 bg-white p-2 shadow-lift">
          {mainNav.map((item) => (
            <a href={item.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-ink-700 hover:bg-ink-50">{item.label}</a>
          ))}
          <a href="/contact/" class="mt-1 block rounded-lg bg-ink-900 px-3 py-2.5 text-center text-sm font-semibold text-white">Book a working session</a>
        </div>
      </details>
    </div>
  </div>
</header>
