---
interface Props { step: number; title: string; last?: boolean }
const { step, title, last = false } = Astro.props;
---
<li class="relative flex gap-5 pb-10 last:pb-0">
  {!last && <span class="absolute left-[19px] top-12 h-[calc(100%-2.5rem)] w-px bg-ink-200" aria-hidden="true"></span>}
  <span class="z-10 flex h-10 w-10 flex-none items-center justify-center rounded-full bg-ink-900 font-mono text-sm font-semibold text-white">{step}</span>
  <div class="pt-1">
    <h3 class="font-serif text-xl font-semibold text-ink-900">{title}</h3>
    <div class="mt-2 text-sm leading-relaxed text-ink-600"><slot /></div>
  </div>
</li>
