---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost" | "onInk";
  class?: string;
}
const { href, variant = "primary", class: cls = "" } = Astro.props;
const base =
  "inline-flex items-center justify-center gap-2 rounded-lg px-5 py-3 text-sm font-semibold transition focus-visible:outline-2";
const variants = {
  primary: "bg-signal-600 text-white shadow-sm hover:bg-signal-700",
  secondary: "border border-ink-200 bg-white text-ink-900 hover:border-ink-300 hover:bg-ink-50",
  ghost: "text-ink-700 hover:text-ink-900",
  onInk: "bg-white text-ink-900 hover:bg-sand-100",
};
---
<a href={href} class:list={[base, variants[variant], cls]}>
  <slot />
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
    <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>
