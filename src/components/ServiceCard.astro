---
interface Props {
  title: string;
  short: string;
  blurb: string;
  href: string;
  index?: number;
}
const { title, short, blurb, href, index } = Astro.props;
---
<a
  href={href}
  class="group relative flex flex-col rounded-2xl border border-ink-100 bg-white p-7 shadow-card transition hover:-translate-y-0.5 hover:border-signal-200 hover:shadow-lift"
>
  {index !== undefined && (
    <span class="font-mono text-xs font-semibold text-signal-600">{String(index + 1).padStart(2, "0")}</span>
  )}
  <h3 class="mt-3 font-serif text-2xl font-semibold text-ink-900">{title}</h3>
  <p class="mt-1.5 text-sm font-medium text-signal-700">{short}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-600">{blurb}</p>
  <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-ink-900">
    Explore service
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </span>
</a>
