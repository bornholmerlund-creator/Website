---
interface Props {
  href: string;
  client: string;
  industry: string;
  title: string;
  metric: string;
  metricLabel: string;
}
const { href, client, industry, title, metric, metricLabel } = Astro.props;
---
<a href={href} class="group flex flex-col rounded-2xl border border-ink-100 bg-white p-7 shadow-card transition hover:-translate-y-0.5 hover:shadow-lift">
  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ink-400">
    <span>{industry}</span>
  </div>
  <h3 class="mt-3 font-serif text-xl font-semibold text-ink-900 group-hover:text-signal-700">{title}</h3>
  <p class="mt-1 text-sm text-ink-500">{client}</p>
  <div class="mt-6 flex items-end justify-between border-t border-ink-100 pt-5">
    <div>
      <div class="font-serif text-3xl font-semibold text-signal-600">{metric}</div>
      <div class="text-xs text-ink-500">{metricLabel}</div>
    </div>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true" class="text-ink-400 transition-transform group-hover:translate-x-1 group-hover:text-signal-600"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </div>
</a>
