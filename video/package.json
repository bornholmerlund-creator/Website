{
  "name": "northbound-data-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts NorthboundData out/northbound-data-30s.mp4 --crf=16",
    "render:30": "remotion render src/index.ts NorthboundData30 out/northbound-data-30s-30fps.mp4 --crf=16",
    "still": "remotion still src/index.ts NorthboundData",
    "music:pbi": "python3 tools/make_music.py public/music/pbi-bed.wav && ffmpeg -y -i public/music/pbi-bed.wav -b:a 192k public/music/pbi-bed.mp3",
    "render:pbi": "remotion render src/index.ts PowerBI out/northbound-data-powerbi-40s.mp4 --crf=18 --concurrency=1",
    "render:pbi-clean": "remotion render src/index.ts PowerBIClean out/northbound-data-powerbi-40s-uden-tekster.mp4 --crf=18 --concurrency=1",
    "render:pbi-vo": "remotion render src/index.ts PowerBI out/northbound-data-powerbi-40s-speak.mp4 --crf=18 --concurrency=1 --props='{\"subtitles\":true,\"voiceover\":true}'",
    "subs:pbi": "node tools/make_subs.mjs out"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.542",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "typescript": "^7.0.2"
  }
}
